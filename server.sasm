; ポート5001 = 0x1389
.org 0x2000
LOAD A,0x89
OUT 0x15,A          ; 下位
LOAD A,0x13
OUT 0x15,A          ; 上位
OUT 0x17,A          ; 待ち受け開始

waitclient:
    IN 0x17,A       ; 客が来たか
    CMP A,0
    JZ waitclient

recvloop:
    IN 0x12,A       ; 読めるか
    CMP A,0
    JZ recvloop
    IN 0x13,A       ; 1バイト受信
    OUT 1,A         ; 画面に表示
    JMP recvloop
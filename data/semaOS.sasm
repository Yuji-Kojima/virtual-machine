.org 0x100

;2026/10/26 
;OSの作成開始。
;keyboard,clear,echoサブルーチンを作成。ABCレジスタを破壊する
;2026/10/27(1)
;メモリを読み取って解釈する仕組みを作った。
;2026/10/28
;カラーテストを作った。
;OSのver0.1完成。message1を差し替え。ファイルを読めるようになった。

message1: ;起動時メッセージ
    LOAD A,0x57 ;W
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x6c ;l
    OUT 1,A
    LOAD A,0x63 ;c
    OUT 1,A
    LOAD A,0x6f ;o
    OUT 1,A
    LOAD A,0x6d ;m
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x74 ;t
    OUT 1,A
    LOAD A,0x6f ;o
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x73 ;s
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x6d ;m
    OUT 1,A
    LOAD A,0x61 ;a
    OUT 1,A
    LOAD A,0x4f ;O
    OUT 1,A
    LOAD A,0x53 ;S
    OUT 1,A
    LOAD A,0x20 ;(スペース)
    OUT 1,A
    LOAD A,0x21 ;!
    OUT 1,A
    LOAD A,0x0a ;\n
    OUT 1,A
    RET
    
message2: ;催促
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x4e ;N
    OUT 1,A
    LOAD A,0x54 ;T
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x52 ;R
    OUT 1,A
    LOAD A,0x3e ;>
    OUT 1,A
    RET

message3: ;シャットダウン用
    LOAD A,0x53 ;S
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x59 ;Y
    OUT 1,A
    LOAD A,0x4f ;O
    OUT 1,A
    LOAD A,0x55 ;U
    OUT 1,A
    LOAD A,0x0a ;\n
    OUT 1,A
    RET

fileload:
    LOAD B,0x00
    LOAD C,0x80
    CALL clear    ;0x8000~0x80FFを0で埋める
    LOAD B,0x00
    LOAD C,0x80
    CALL keyboard ; 0x8000~0x80FFに入力を受け取る
    CALL 0x03
    CALL 0x2000
    RET

clear: ;指定されたところから256個までメモリを消す
    LOAD A,0
    STOREI A,B,C
    ADD B,1 
    JNC clear ;Bが256超えるまでループ
    RET

keyboard: ;256バイトまでキー入力を受け取る
    IN 2,A      ; キーボード入力を待たずに受け取る
    CMP A,0
    JZ keyboard ; ニュートラルならループ
    CMP A,0x0D
    JZ fend     ; 0x0D (Enter)を受け取ったらRETの部分へ
    CMP B,0xFF  ; 256超えたらRETへ
    JZ fend
    STOREI A,B,C ; CBのアドレスにAを書き込む
    OUT 1,A     ; 入力したものを見せる
    ADD B,1     ; メモリを一つ進める
    JMP keyboard; ループ
    fend:
        LOAD A,0x0a ;\n 改行
        OUT 1,A
        RET

echo: ;メモリ内容を返す
    LOADI A,B,C ; CB番地からAに代入
    OUT 1,A     ; Aを出力
    ADD B,1     ; メモリ進めて
    CMP A,0     
    JNZ echo    ;0x00じゃなければループ
    LOAD A,0x0a ;\n全部出力したら改行して終わり
    OUT 1,A
    RET

read: ;読んでから読む位置を更新する
    LOADI A,B,C 
    ADD B,1 
    RET

d: ;Dレジスタを+1する
    ADD D,1
    RET
    
colortest: ;display.pyをチェックする。0キーで終了
    
    LOAD B,0x00     ; カーソルのアドレス = 0xA000 (C が上位、B が下位)
    LOAD C,0xA0
    LOAD D,3        ; 描く色 (パレット番号 0~3)
    OUT 3,A         ; ディスプレイ起動 (Aの値は使われない)
    STOREI D,B,C    ; 最初の1ドット
    JMP ct_loop

ct_up: ;1行上へ (アドレス -128)
    SUB B,0x80
    JNC ct_up_end   ; 下位が足りなくて借りが出たら上位も1減らす
    DEC C
    ct_up_end:
    RET

ct_down: ;1行下へ (アドレス +128)
    ADD B,0x80
    JNC ct_down_end ; 桁上がりが出たら上位を1増やす
    INC C
    ct_down_end:
    RET

ct_left: ;1つ左へ
    DEC B
    JNC ct_left_end ; 0から引いて借りが出たら上位も1減らす
    DEC C
    ct_left_end:
    RET

ct_right: ;1つ右へ
    INC B
    JNC ct_right_end
    INC C
    ct_right_end:
    RET

ct_c0:
    LOAD D,0
    RET
ct_c1:
    LOAD D,1
    RET
ct_c2:
    LOAD D,2
    RET
ct_c3:
    LOAD D,3
    RET

ct_loop:
    IN 2,A          ; キー入力
    CMP A,0x30      ; 0キー
    JZ ct_exit
    CMP A,0x77      ; w
    CALZ ct_up
    CMP A,0x73      ; s
    CALZ ct_down
    CMP A,0x61      ; a
    CALZ ct_left
    CMP A,0x64      ; d
    CALZ ct_right
    CMP A,0x31      ; 1 → すごく暗い青
    CALZ ct_c1
    CMP A,0x32      ; 2 → 暗い青
    CALZ ct_c2
    CMP A,0x33      ; 3 → 青
    CALZ ct_c3
    CMP A,0x34      ; 4 → 黒(消しゴム)
    CALZ ct_c0
    STOREI D,B,C    ; 今のカーソル位置に色Dを書く
    JMP ct_loop

ct_exit:
    OUT 4,A         ; ディスプレイ終了
    RET


command:

        ;判定部分。
        ;readで0x8000から1つずつ進めて、一致していたらDに+1、全部一致でCALZで指定のサブルーチンに飛ぶ
    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x65  ; e
    CALZ d
    CALL read   
    CMP A,0x78    ; x
    CALZ d
    CALL read
    CMP A,0x69  ; i
    CALZ d
    CALL read   
    CMP A,0x74    ; t
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,5
    CALZ shutdown ; シャットダウン

    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x63  ; C
    CALZ d
    CALL read   
    CMP A,0x6f    ; o
    CALZ d
    CALL read
    CMP A,0x6c  ; l
    CALZ d
    CALL read   
    CMP A,0x6f    ; o
    CALZ d
    CALL read   
    CMP A,0x72  ; r
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,6
    CALZ colortest ; カラーテスト

    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x66  ; f
    CALZ d
    CALL read
    CMP A,0x69  ; i
    CALZ d
    CALL read
    CMP A,0x6c  ; l
    CALZ d
    CALL read   
    CMP A,0x65  ; e
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,5
    CALZ fileload ; ファイル読み込み

    RET

shutdown:
    CALL message3
    HALT

start:
    CALL message1     ; 起動メッセージ
    main:
        CALL message2 ; 入力催促するメッセージ
        LOAD C 0x80
        LOAD B,0
        CALL clear    ;0x8000~0x80FFを0で埋める
        CALL keyboard ; 0x8000~0x80FFに入力を受け取る
        LOAD C 0x80
        LOAD B,0
        CALL echo     ; 出力して入力を返す
        CALL command
        JMP main
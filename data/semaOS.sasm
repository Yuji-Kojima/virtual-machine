.org 0x100

;2026/10/26 
;OSの作成開始。
;keyboard,clear,echoサブルーチンを作成。ABCレジスタを破壊する
;2026/10/27(1)
;メモリを読み取って解釈する仕組みを作った。
;2026/10/28
;カラーテストを作った。
;OSのver0.1完成。message1を差し替え。ファイルを読めるようになった。
;2026/10/29(1)
;サブルーチンのジャンプ表を入れてみた
;2026/10/29(2)
;画像表示部分を作成中。
;2026/10/30
;
;2026/10/31
;やっと画像表示ができるようになった。今のcopypictureは名前を入力しないといけないので、そのうちここを自動でできるようにして新しいものを作る。これはあくまでテスト用の読み込みサブルーチンのため

JMP message1     ; 0x0100
JMP message2     ; 0x0103
JMP message3     ; 0x0106
JMP clear        ; 0x0109
JMP keyboard     ; 0x010C
JMP echo         ; 0x010F
JMP copypicture  ; 0x0112
JMP drawpicture  ; 0x0115

message1: ;起動時メッセージ
    LOAD A,0x57 ;W
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x6c ;l
    OUT 1,A
    LOAD A,0x63 ;c
    OUT 1,A
    LOAD A,0x6f ;o
    OUT 1,A
    LOAD A,0x6d ;m
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x74 ;t
    OUT 1,A
    LOAD A,0x6f ;o
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x73 ;s
    OUT 1,A
    LOAD A,0x65 ;e
    OUT 1,A
    LOAD A,0x6d ;m
    OUT 1,A
    LOAD A,0x61 ;a
    OUT 1,A
    LOAD A,0x4f ;O
    OUT 1,A
    LOAD A,0x53 ;S
    OUT 1,A
    LOAD A,0x20 ;(スペース)
    OUT 1,A
    LOAD A,0x21 ;!
    OUT 1,A
    LOAD A,0x0a ;\n
    OUT 1,A
    RET
    
message2: ;催促
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x4e ;N
    OUT 1,A
    LOAD A,0x54 ;T
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x52 ;R
    OUT 1,A
    LOAD A,0x3e ;>
    OUT 1,A
    RET

message3: ;シャットダウン用
    LOAD A,0x53 ;S
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x45 ;E
    OUT 1,A
    LOAD A,0x5f ;_
    OUT 1,A
    LOAD A,0x59 ;Y
    OUT 1,A
    LOAD A,0x4f ;O
    OUT 1,A
    LOAD A,0x55 ;U
    OUT 1,A
    LOAD A,0x0a ;\n
    OUT 1,A
    RET

fileload:
    LOAD B,0x00
    LOAD C,0x80
    CALL clear    ;0x8000~0x80FFを0で埋める
    LOAD B,0x00
    LOAD C,0x80
    CALL keyboard ; 0x8000~0x80FFに入力を受け取る
    CALL 0x03
    CALL 0x2000
    RET

clear: ;指定されたところから256個までメモリを消す
    LOAD A,0
    STOREI A,B,C
    ADD B,1 
    JNC clear ;Bが256超えるまでループ
    RET

keyboard: ;256バイトまでキー入力を受け取る
    IN 2,A      ; キーボード入力を待たずに受け取る
    CMP A,0
    JZ keyboard ; ニュートラルならループ
    CMP A,0x0D
    JZ fend     ; 0x0D (Enter)を受け取ったらRETの部分へ
    CMP B,0xFF  ; 256超えたらRETへ
    JZ fend
    STOREI A,B,C ; CBのアドレスにAを書き込む
    OUT 1,A     ; 入力したものを見せる
    ADD B,1     ; メモリを一つ進める
    JMP keyboard; ループ
    fend:
        LOAD A,0x0a ;\n 改行
        OUT 1,A
        RET

echo: ;メモリ内容を返す
    LOADI A,B,C ; CB番地からAに代入
    OUT 1,A     ; Aを出力
    ADD B,1     ; メモリ進めて
    CMP A,0     
    JNZ echo    ;0x00じゃなければループ
    LOAD A,0x0a ;\n全部出力したら改行して終わり
    OUT 1,A
    RET

read: ;読んでから読む位置を更新する
    LOADI A,B,C 
    ADD B,1 
    RET

d: ;Dレジスタを+1する
    ADD D,1
    RET
    
colortest: ;display.pyをチェックする。0キーで終了
    
    LOAD B,0x00     ; カーソルのアドレス = 0xA000 (C が上位、B が下位)
    LOAD C,0xA0
    LOAD D,3        ; 描く色 (パレット番号 0~3)
    OUT 3,A         ; ディスプレイ起動 (Aの値は使われない)
    STOREI D,B,C    ; 最初の1ドット
    JMP ct_loop

ct_up: ;1行上へ (アドレス -128)
    SUB B,0x80
    JNC ct_up_end   ; 下位が足りなくて借りが出たら上位も1減らす
    DEC C
    ct_up_end:
    RET

ct_down: ;1行下へ (アドレス +128)
    ADD B,0x80
    JNC ct_down_end ; 桁上がりが出たら上位を1増やす
    INC C
    ct_down_end:
    RET

ct_left: ;1つ左へ
    DEC B
    JNC ct_left_end ; 0から引いて借りが出たら上位も1減らす
    DEC C
    ct_left_end:
    RET

ct_right: ;1つ右へ
    INC B
    JNC ct_right_end
    INC C
    ct_right_end:
    RET

ct_c0:
    LOAD D,0
    RET
ct_c1:
    LOAD D,1
    RET
ct_c2:
    LOAD D,2
    RET
ct_c3:
    LOAD D,3
    RET

ct_loop:
    IN 2,A          ; キー入力
    CMP A,0x30      ; 0キー
    JZ ct_exit
    CMP A,0x77      ; w
    CALZ ct_up
    CMP A,0x73      ; s
    CALZ ct_down
    CMP A,0x61      ; a
    CALZ ct_left
    CMP A,0x64      ; d
    CALZ ct_right
    CMP A,0x31      ; 1 → すごく暗い青
    CALZ ct_c1
    CMP A,0x32      ; 2 → 暗い青
    CALZ ct_c2
    CMP A,0x33      ; 3 → 青
    CALZ ct_c3
    CMP A,0x34      ; 4 → 黒(消しゴム)
    CALZ ct_c0
    STOREI D,B,C    ; 今のカーソル位置に色Dを書く
    JMP ct_loop

ct_exit:
    OUT 4,A         ; ディスプレイ終了
    RET

copypicture:
    PUSH B
    PUSH C
    LOAD B, 0x00
    LOAD C, 0x80
    cploop:

        LOADI A, B, C   
        OUT 5, A        ; 名前を1文字送る(最後の0も送る → open)
        INC B           ; 次の文字へ
        CMP A, 0
        JNZ cploop
    IN 7, A
    CMP A, 0
    JNZ cpfail          ; 0以外(ファイルなし/空)なら失敗。A=状態のまま戻る
    
    IN 6,A
    CMP A,0x41          ;A(ヘッダー確認。)
    JNZ cpfail
    IN 6,A
    CMP A,0x52          ;R(semartファイルのヘッダーは、ART縦横)
    JNZ cpfail
    IN 6,A
    CMP A,0x54          ;T
    JNZ cpfail

    IN 6,A              ;縦
    IN 6,D              ;横

    POP C   ;返してもらう
    POP B   ;場所を受け取る
    

    STOREI A,B,C     ;縦を置く
    ADD B,1
    CALC plusc
    STOREI D,B,C     ;横を置く
    ADD B,1
    CALC plusc



    copyloop:            ; ピクセルを EOF まで置く
        IN 7,A           ; 0=読める、1=最後まで
        CMP A,0
        JNZ cpdone
        IN 6,A
        STOREI A,B,C
        INC B
        JNZ copyloop
        INC C
        JMP copyloop

    cpfail: ;失敗したら帰る
        POP C   ;必ず返してもらう。
        POP B   ;
        RET
    cpdone:
        LOAD A,0         ; 成功
        RET
    plusc:  ;キャリーフラグ用
        ADD C,1
        RET

; 作業変数(0x90F0~0x90F7。OSの入力バッファとは別の場所)
; 0x90F0 残りの行数   0x90F1 横幅   0x90F2 行の残りピクセル数
; 0x90F3,0x90F4 読み出し番地(下位,上位)
; 0x90F5,0x90F6 書き込み番地(下位,上位)

drawpicture:         ; B,C=画像の番地  A,D=VRAMの位置(下位,上位)  A,B,C,Dは壊れる
    STOREM A,0x90F5
    STOREM D,0x90F6
    LOADI A,B,C      ; 縦
    STOREM A,0x90F0
    INC B
    JNZ dp_s1
    INC C
dp_s1:
    LOADI A,B,C      ; 横
    STOREM A,0x90F1
    STOREM A,0x90F2
    INC B
    JNZ dp_s2
    INC C
dp_s2:
    STOREM B,0x90F3
    STOREM C,0x90F4

dp_loop:
    LOADM B,0x90F3   ; 読み出し番地
    LOADM C,0x90F4
    LOADI A,B,C
    INC B
    JNZ dp_r1
    INC C
dp_r1:
    STOREM B,0x90F3
    STOREM C,0x90F4

    LOADM B,0x90F5   ; 書き込み番地
    LOADM C,0x90F6
    STOREI A,B,C
    INC B
    JNZ dp_w1
    INC C
dp_w1:
    STOREM B,0x90F5
    STOREM C,0x90F6

    LOADM A,0x90F2   ; 行の残りピクセルを1減らす
    DEC A
    STOREM A,0x90F2
    JNZ dp_loop      ; まだ行の途中

    ; 行の終わり
    LOADM A,0x90F0   ; 残りの行数を1減らす
    DEC A
    STOREM A,0x90F0
    JZ dp_end        ; 全部描いた

    LOADM A,0x90F1   ; 横幅
    STOREM A,0x90F2  ; 行の残りを横幅に戻す
    LOAD D,128
    SUBR D,A         ; D = 128 - 横幅(次の行の左端までの差)
    LOADM B,0x90F5
    LOADM C,0x90F6
    ADDR B,D
    JNC dp_n1        ; 桁上がりが出たときだけ上位を進める
    INC C
dp_n1:
    STOREM B,0x90F5
    STOREM C,0x90F6
    JMP dp_loop

dp_end:
    RET












command:

        ;判定部分。
        ;readで0x8000から1つずつ進めて、一致していたらDに+1、全部一致でCALZで指定のサブルーチンに飛ぶ
    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x65  ; e
    CALZ d
    CALL read   
    CMP A,0x78    ; x
    CALZ d
    CALL read
    CMP A,0x69  ; i
    CALZ d
    CALL read   
    CMP A,0x74    ; t
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,5
    CALZ shutdown ; シャットダウン

    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x63  ; C
    CALZ d
    CALL read   
    CMP A,0x6f    ; o
    CALZ d
    CALL read
    CMP A,0x6c  ; l
    CALZ d
    CALL read   
    CMP A,0x6f    ; o
    CALZ d
    CALL read   
    CMP A,0x72  ; r
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,6
    CALZ colortest ; カラーテスト

    LOAD C 0x80
    LOAD B,0 
    LOAD D,0    
    CALL read   
    CMP A,0x66  ; f
    CALZ d
    CALL read
    CMP A,0x69  ; i
    CALZ d
    CALL read
    CMP A,0x6c  ; l
    CALZ d
    CALL read   
    CMP A,0x65  ; e
    CALZ d
    CALL read   
    CMP A,0x00    ; 0x00
    CALZ d
    CMP D,5
    CALZ fileload ; ファイル読み込み

    RET

shutdown:
    CALL message3
    OUT 4,A
    HALT

start:
    CALL message1     ; 起動メッセージ
    main:
        CALL message2 ; 入力催促するメッセージ
        LOAD C 0x80
        LOAD B,0
        CALL clear    ;0x8000~0x80FFを0で埋める
        CALL keyboard ; 0x8000~0x80FFに入力を受け取る
        LOAD C 0x80
        LOAD B,0
        CALL echo     ; 出力して入力を返す
        CALL command
        JMP main
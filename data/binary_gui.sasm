.org 0x2000

extension:

    LOAD A,0x2e     ;.
    STOREM A,0x8001
    LOAD A,0x73     ;s
    STOREM A,0x8002
    LOAD A,0x65     ;e
    STOREM A,0x8003
    LOAD A,0x6d     ;m
    STOREM A,0x8004
    LOAD A,0x61     ;a
    STOREM A,0x8005
    LOAD A,0x72     ;r
    STOREM A,0x8006
    LOAD A,0x74     ;t
    STOREM A,0x8007
    LOAD A,0x00     ;空白
    STOREM A,0x8008
    RET

pic_load:

    CALL extension  ;まず拡張子をつける
    LOAD D,0x00 ;カウンター
    LOAD A,0x30 ;0の文字コード
    LOAD B,0x00 ; 0xE000から画像を並べていく
    LOAD C,0xE0 ; 
    num_loop:
        STOREM A,0x8000 ;Aの値を入れる(0~9)
        PUSH A
        PUSH D
        CALL 0x0112
        POP D
        POP A
        ADD D,1
        ADD A,1
        CMP D,10
        JNZ num_loop
    LOAD D,0x00 ;カウンター
    LOAD A,0x61 ;aの文字コード
    str_loop:
        STOREM A,0x8000 ;Aの値を入れる(a~f、記号のxと矢印)
        PUSH A
        PUSH D
        CALL 0x0112
        POP D
        POP A
        ADD D,1
        ADD A,1
        CMP D,8
        JNZ str_loop
        RET



up:     ;上へ
LOADM C,0x8912
LOADM B,0x8911
SUB B,1
CALC upcal
STOREM C,0x8912
STOREM B,0x8911
CALL change_flag

RET
upcal:  ;繰り下がり
SUB C,1
RET

down:     ;下へ
LOADM C,0x8912
LOADM B,0x8911
ADD B,1
CALC downcal
STOREM C,0x8912
STOREM B,0x8911
CALL change_flag
RET
downcal:  ;繰り下がり
ADD C,1
RET

left:     ;えぐい上へ
LOADM C,0x8912
LOADM B,0x8911
SUB B,0x0F
CALC upcal
STOREM C,0x8912
STOREM B,0x8911
CALL change_flag

right:     ;えぐい下へ
LOADM C,0x8912
LOADM B,0x8911
ADD B,0x0F
CALC downcal
STOREM C,0x8912
STOREM B,0x8911
CALL change_flag



num_get:        ;0x8888に入れたものの文字をCBに読み込む
    LOAD C,0xE0
    LOAD B,0x00
    PUSH A
    PUSH D
    LOADM A,0x8888  ; 読み込む
    LOAD D,0x00     ; カウンター
    CMP A,0
    JZ get_end

    get_loop:       ;ひたすらBに0x42を足す。
        ADD B,0x42
        CALC get_cal;繰り上がり
        ADD D,1     ;カウンター+1
        CMPR A,D    ;比べる
        JNZ get_loop
    get_end:        ;A,Dを返してもらって帰宅
        POP D
        POP A
        RET
    get_cal:        ;繰り上がり
        ADD C,1
        RET

num0:
    LOAD C,0xE0
    LOAD B,0x00
    RET
num1:
    LOAD C,0xE0
    LOAD B,0x42
    RET
num2:
    LOAD C,0xE0
    LOAD B,0x84
    RET
num3:
    LOAD C,0xE0
    LOAD B,0xC6
    RET
num4:
    LOAD C,0xE1
    LOAD B,0x08
    RET
num5:
    LOAD C,0xE1
    LOAD B,0x4A
    RET
num6:
    LOAD C,0xE1
    LOAD B,0x8C
    RET
num7:
    LOAD C,0xE1
    LOAD B,0xCE
    RET
num8:
    LOAD C,0xE2
    LOAD B,0x10
    RET
num9:
    LOAD C,0xE2
    LOAD B,0x52
    RET
stra:
    LOAD C,0xE2
    LOAD B,0x94
    RET
strb:
    LOAD C,0xE2
    LOAD B,0xD6
    RET
strc:
    LOAD C,0xE3
    LOAD B,0x18
    RET
strd:
    LOAD C,0xE3
    LOAD B,0x5A
    RET
stre:
    LOAD C,0xE3
    LOAD B,0x9C
    RET
strf:
    LOAD C,0xE3
    LOAD B,0xDE
    RET
strx:
    LOAD C,0xE4
    LOAD B,0x20
    RET
arrow:
    LOAD C,0xE4
    LOAD B,0x62
    RET


start:
    OUT 3,A
    CALL pic_load   ;ファイルを0xE000から順に並べる
    LOAD B,0x00     ; 2バイトでアドレスを表現する
    LOAD C,0x00
    CALL change_flag
    main_loop:
        IN 2,A      ;キー受け取り
        CMP A,0x77  ;w
        CALZ up
        CMP A,0x73  ;s
        CALZ down
        CMP A,0x61  ;a
        CALZ left
        CMP A,0x64  ;d
        CALZ right
        CMP A,0x0d  ;enter
        JZ end
        LOAD A,0x00
        LOAD D,0xA0
        STOREM C,0x8912
        STOREM B,0x8911
        CALL change_check
        LOADM C,0x8912
        LOADM B,0x8911
        JMP main_loop

change_check:
    PUSH A
    LOADM A,0x8913
    CMP A,0xFF
    CALZ draw
    LOAD A,0
    STOREM A,0x8913
    POP A
    RET

change_flag:
    PUSH A
    LOAD A,0xFF
    STOREM A,0x8913
    POP A
    RET

drawcal:  
    ADD C,1
    RET

draw:
    ;現在地を確認、1文字ずつ描画*7。
    ;レジスタがあまりに足りないため、全部メモリで補う。
    ;0x8900,01 VRAM上位下位 +128で1ドット下に移動するため、+1024で8ドット下に送る。
    ;0x8902,03 アドレス
    ;0x8904,5,6,7 アドレスを1文字ずつ分解したもの。
    ;0x8908 4文字カウンター(不要だった)
    ;0x8909 7行カウンター
    ;0x8910 アドレスの中身
    ;0x8911,12もともといたアドレス
    ;0x8913 変更をチェックする。0 or 255



    STOREM D,0x8900
    STOREM A,0x8901
    
    STOREM C,0x8902
    STOREM B,0x8903

    PUSH A
    LOAD A,0x00
    STOREM A,0x8909
    POP A

    draw_loop:          ;↑初期値セット

    LOADM C,0x8903
    AND C,0b00001111
    STOREM C,0x8907     ;後ろから詰める4

    LOADM C,0x8903
    AND C,0b11110000
    SHR C
    SHR C
    SHR C
    SHR C
    STOREM C,0x8906     ;後ろから詰める3

    LOADM B,0x8902
    AND B,0b00001111
    STOREM B,0x8905     ;後ろから詰める2

    LOADM B,0x8902
    AND B,0b11110000
    SHR B
    SHR B
    SHR B
    SHR B
    STOREM B,0x8904     ;後ろから詰める1

    ;↑ここでアドレスの数字セットを終えた


    CALL arrow
    LOADM A,0x8901
    LOADM D,0x8900
    CALL 0x0115

    CALL strx
    LOADM A,0x8901
    ADD A,8
    STOREM A,0x8901
    LOADM D,0x8900
    CALL 0x0115

    ;アドレスの描画スタート
    ADD A,8
    STOREM A,0x8901
    LOADM D,0x8904  ;4桁目
    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901

    ADD A,8 
    STOREM A,0x8901
    LOADM D,0x8905  ;3桁目
    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901

    ADD A,8 
    STOREM A,0x8901
    LOADM D,0x8906  ;2桁目
    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901

    ADD A,8 
    STOREM A,0x8901
    LOADM D,0x8907  ;1桁目
    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901

    ;アドレスの描画が終わったので、中身の描画に入る

    LOADM C,0x8902
    LOADM B,0x8903

    ADD A,8

    LOADI D,B,C     ;DにCB番地の中身を代入
    STOREM D,0x8910 ;8910にそれをコピー
    ADD A,8
    AND D,0b11110000;上位
    SHR D 
    SHR D 
    SHR D 
    SHR D 
    STOREM A,0x8901
    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901
    LOADM D,0x8910  ;また中身を持ってくる
    ADD A,8
    AND D,0b00001111;下位
    STOREM A,0x8901

    STOREM D,0x8888
    CALL num_get
    LOADM D,0x8900  ;VRAMのアドレスを読み取る
    CALL 0x0115     ;実際に描画
    LOADM A,0x8901

    LOADM B,0x8903
    LOADM C,0x8902

    ADD B,1
    CALC drawcal
    STOREM C,0x8902
    STOREM B,0x8903     ;ループ前にアドレスを1つ進める

    LOADM D,0x8900
    LOADM A,0x8901

    ADD D,5
    STOREM D,0x8900     ;Dの値を+5してメモリに入れなおす

    LOADM D,0x8909
    ADD D,1
    STOREM D,0x8909
    CMP D,5
    JNZ draw_loop
    
    RET





    




test:
    LOAD A,0x00
    LOAD D,0xA1

    PUSH A
    LOAD A,0x0E
    STOREM A,0x8888
    POP A
    CALL num_get    ;この5行でひとかたまり

    CALL 0x0115

    LOAD A,0x08
    LOAD D,0xA1
    CALL num2
    CALL 0x0115

    LOAD A,0x0F
    LOAD D,0xA1
    CALL num3
    CALL 0x0115

    LOAD A,0x18
    LOAD D,0xA1
    CALL stra
    CALL 0x0115
    RET

end:
    OUT 4,A
    RET
        



    